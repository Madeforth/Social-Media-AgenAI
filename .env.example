# =============================================================================
# Apex Social AI — environment template
# Copy to apps/web/.env.local and apps/mobile/.env and fill in real values.
# NEVER commit real credentials. Server-only secrets live in Supabase secrets.
# =============================================================================

# --- Public (safe to ship in a web or mobile bundle) --------------------------
# The publishable key grants nothing on its own: every table in `public` has RLS
# enabled and the `anon` role holds no grants.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# --- Server-only (Supabase Edge Function secrets — never bundled in a client) -
# Set with: npx supabase secrets set KEY=value
# SUPABASE_SECRET_KEY=
# GEMINI_API_KEY=
# META_APP_ID=
# META_APP_SECRET=
# META_WEBHOOK_VERIFY_TOKEN=
