# =============================================================================
# Apex Social AI — environment template
# Copy to .env.local (web) / .env (mobile) and fill in real values.
# NEVER commit real credentials. Server-only secrets live in Supabase secrets.
# =============================================================================

# --- Public (safe to expose to web/mobile clients) ---------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# --- Server-only (Supabase Edge Function secrets — never bundled in a client) -
# Set with: npx supabase secrets set KEY=value
# SUPABASE_SERVICE_ROLE_KEY=
# GEMINI_API_KEY=
# META_APP_ID=
# META_APP_SECRET=
# META_WEBHOOK_VERIFY_TOKEN=
