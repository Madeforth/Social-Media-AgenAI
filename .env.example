# =============================================================================
# Apex Social AI — environment template
# Copy to apps/web/.env.local and apps/mobile/.env and fill in real values.
# NEVER commit real credentials. Server-only secrets live in Supabase secrets.
# =============================================================================

# --- Public (safe to ship in a web or mobile bundle) --------------------------
# The publishable key grants nothing on its own: every table in `public` has RLS
# enabled and the `anon` role holds no grants.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# --- Server-only (Supabase Edge Function secrets — never bundled in a client) -
# Set with: npx supabase secrets set KEY=value
# SUPABASE_SECRET_KEY=
# GEMINI_API_KEY=
# META_APP_ID=
# META_APP_SECRET=
# META_WEBHOOK_VERIFY_TOKEN=

# --- Creative Engine V2 (Supabase Edge Function secrets, off by default) ------
# CREATIVE_ENGINE_V2_ENABLED=false
# CREATIVE_ENGINE_CANDIDATE_COUNT=2
# CREATIVE_RENDER_URL=https://your-web-app.example/api/internal/creative-render
# CREATIVE_RENDER_SIGNING_SECRET=
# GEMINI_VISION_MODEL=
