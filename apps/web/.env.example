NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Creative Engine V2 compositor route (apps/web/src/app/api/internal/creative-render).
# Off by default via CREATIVE_ENGINE_V2_ENABLED on the Supabase Edge Function side —
# these only matter once that flag is turned on. Use a random, unguessable value for
# the signing secret and keep it identical to the same-named Edge Function secret.
CREATIVE_RENDER_SIGNING_SECRET=
CREATIVE_RENDER_MAX_BYTES=12582912
CREATIVE_RENDER_CLOCK_SKEW_SECONDS=60
